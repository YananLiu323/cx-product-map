    "@sentry/electron": "^7.5.0",
    "@sentry/node": "10.29.0",
    "@worklouder/device-kit-ark": "file:../vendor/ark-js-registry/worklouder/device-kit-ark/0.2.1/package",
    "@worklouder/wl-device-kit": "file:../vendor/ark-js-registry/worklouder/wl-device-kit/0.2.2/package",
    "app-server-manager": "workspace:*",
    "app-server-types": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "browser-api": "file:../../../lib/ark_browser_use/browser-api",
    "browser-backend-common": "link:../../../lib/ark_browser_use/browser-backend-common",
    "browser-common": "workspace:*",
    "bufferutil": "^4.0.1",
    "capnweb": "^0.11.1",
    "commands": "workspace:*",
