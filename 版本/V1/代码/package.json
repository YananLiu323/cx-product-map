    "external-agent-migration": "workspace:*",
    "extract-zip": "2.0.1",
    "git-worker": "workspace:*",
    "lodash": "^4.18.1",
    "mime-types": "^2.1.35",
    "node-pty": "^1.1.0",
    "objc-js": "1.5.0",
    "protocol": "workspace:*",
    "shared-node": "workspace:*",
    "shlex": "^3.0.0",
    "smol-toml": "^1.7.0",
    "ssh-config": "^5.2.0",
    "tar": "7.5.16",
    "tldts": "7.4.9",
    "tslib": "^2.8.1",
    "utf-8-validate": "^6.0.0",
    "vscode-jsonrpc": "8.2.0",
